    "# from litellm import \n",
    "import asyncio\n",
    "from agents import Agent, Runner, set_tracing_disabled\n",
    "from agents.extensions.models.litellm_model import LitellmModel\n",
    "\n",
    "set_tracing_disabled(disabled=False)\n",
    "\n",
    "\n",
    "agent = Agent(\n",
    "    name=\"Assistant\",\n",
    "    instructions=\"You are a great poet\",\n",
    "    model=LitellmModel(model=MODEL)\n",
    ")\n",
    "\n",
    "\n",
    "result = await Runner.run(agent,\"Write a poem about the sea and ocean in the style of Shakespeare, only two stanzas\")\n",
    "print(result)\n",
    "print(result.final_output)"
   ]
